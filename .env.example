# Example environment variables for local development
# Copy this to `.env` and fill with real values. `.env` is gitignored.

# Anthropic / Claude (public key exposed to client if needed)
EXPO_PUBLIC_ANTHROPIC_KEY=REPLACE_WITH_YOUR_ANTHROPIC_KEY

# Firebase frontend config (these are not secret for client apps, but keep them in envs if you prefer)
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
EXPO_PUBLIC_ANTHROPIC_KEY=