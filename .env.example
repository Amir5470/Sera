# Example environment variables for local development
# Copy this to `.env` and fill with real values. `.env` should be gitignored.

# Firebase frontend config (client-side values)
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID

# Secrets Worker URL (development / CI)
# The Cloudflare Worker stores GEMINI_KEY and Cloudinary secrets server-side.
EXPO_PUBLIC_SECRETS_WORKER_URL=https://your-worker-subdomain.workers.dev

# NOTES:
# - Do NOT store server-side secrets (GEMINI_KEY, CLOUDINARY_KEY) here.
#   Use the Cloudflare Worker (see cloudflare-worker/README.md) or set
#   secrets with `wrangler secret put`.
# - Keep your local `.env` out of source control. If you committed secrets,
#   rotate them and purge history.
