# Example environment variables for local development
# Copy this to `.env` and fill with real values. `.env` is gitignored.
# Latest AI: Google Gemini (set provider to 'gemini' to use)
GEMINI_KEY=REPLACE_WITH_GEMINI_KEY
AI_PROVIDER="gemini"

# Firebase frontend config (these are not secret for client apps, but keep them in envs if you prefer)
FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID

# Cloudinary config
CLOUDINARY_UPLOAD_PRESET=REPLACE_WITH_UPLOAD_PRESET_NAME
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_KEY=REPLACE_WITH_CLOUDINARY_KEY
