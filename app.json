    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "bb63d89b-1ad0-40f2-9608-c4e179b3bf2b"
      }
    }
  }
